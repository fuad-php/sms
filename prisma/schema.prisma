// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  tickets  Ticket[]
  uploadHistory UploadHistory[]
  cloudStorageConfigs CloudStorageConfig[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Ticket {
  id                String      @id @default(cuid())
  userId            String
  originalFileName  String
  originalFileType  String
  originalFileUrl   String
  extractedData     Json
  standardizedData  Json
  status            TicketStatus @default(PROCESSING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  exportedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UploadHistory {
  id           String        @id @default(cuid())
  userId       String
  fileName     String
  fileSize     Int
  fileType     String
  status       UploadStatus  @default(UPLOADING)
  progress     Int           @default(0)
  createdAt    DateTime      @default(now())
  completedAt  DateTime?
  errorMessage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CloudStorageConfig {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // 'google' or 'onedrive'
  accessToken  String
  refreshToken String
  folderId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum TicketStatus {
  PROCESSING
  REVIEW
  APPROVED
  EXPORTED
}

enum UploadStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}